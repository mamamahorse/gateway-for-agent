FROM python:3.12-slim-bookworm
ARG WITH_EMBEDDINGS=0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
WORKDIR /app
COPY requirements*.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt \
    && if [ "$WITH_EMBEDDINGS" = "1" ]; then \
         python -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
         && python -m pip install --no-cache-dir -r requirements-local.txt; \
       fi
RUN groupadd --gid 10001 agent && useradd --uid 10001 --gid agent --no-create-home agent
COPY --chown=10001:10001 . ./
RUN mkdir -p /app/.data /app/.models && chown -R 10001:10001 /app/.data /app/.models
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "web_app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
